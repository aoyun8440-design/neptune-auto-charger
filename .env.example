# Neptune 用户配置（本地运行时复制为 .env）
# openId 相当于账户凭证，不要提交到 Git，也不要发到 Issue 或聊天中。
NEPTUNE_OPEN_ID=你的openId
NEPTUNE_AREA_ID=6

# 默认 true，只读取并检查，不发送真实开电请求。
NEPTUNE_DRY_RUN=true

# 自动续充最长分钟数；设备上限更短时以设备上限为准。
NEPTUNE_MAX_CHARGE_TIME=480

# 可选。脚本会通过 openId 自动读取 employeeId；旧配置可保留用于一致性校验。
# NEPTUNE_EMPLOYEE_ID=你的employeeId
